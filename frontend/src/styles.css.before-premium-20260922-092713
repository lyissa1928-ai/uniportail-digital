:root {
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  color: #172033;
  background: #f5f7fb;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  min-height: 100%;
  margin: 0;
}

body {
  min-width: 320px;
}

button,
input {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color:
    transparent;
}

a {
  color: inherit;
  text-decoration: none;
}

.app-shell {
  min-height: 100vh;
  display: grid;
  grid-template-columns:
    260px minmax(0, 1fr);
}

.sidebar {
  min-height: 100vh;
  padding: 24px 18px;
  background: #101827;
  color: white;
  display: flex;
  flex-direction: column;
  position: sticky;
  top: 0;
  height: 100vh;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 8px 24px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  font-weight: 800;
  background: white;
  color: #101827;
}

.brand strong,
.brand span {
  display: block;
}

.brand span {
  margin-top: 3px;
  color: #98a2b3;
  font-size: 12px;
}

.navigation {
  display: grid;
  gap: 5px;
}

.nav-link {
  padding: 11px 12px;
  border-radius: 9px;
  color: #cbd5e1;
  font-size: 14px;
  transition:
    background 0.15s ease,
    color 0.15s ease;
}

.nav-link:hover {
  background:
    rgba(255,255,255,.06);
  color: white;
}

.nav-link.active {
  color: white;
  background:
    rgba(255,255,255,.12);
}

.sidebar-footer {
  margin-top: auto;
  padding: 18px 8px 0;
  border-top:
    1px solid
    rgba(255,255,255,.08);
}

.sidebar-footer span,
.sidebar-footer small {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sidebar-footer small {
  margin-top: 4px;
  color: #98a2b3;
}

.workspace {
  min-width: 0;
}

.topbar {
  min-height: 70px;
  padding: 0 32px;
  background: white;
  border-bottom:
    1px solid #e8edf4;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.user-chip {
  font-size: 13px;
  padding: 8px 12px;
  border-radius: 999px;
  background: #f2f4f7;
}

.content {
  padding: 32px;
}

.page-stack {
  display: grid;
  gap: 24px;
}

.page-header h1 {
  margin: 6px 0;
  font-size: 30px;
  letter-spacing: -0.025em;
}

.page-header p {
  margin: 0;
  color: #667085;
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: .09em;
  font-size: 11px;
  font-weight: 800;
  color: #667085;
}

.panel,
.stat-card {
  background: white;
  border:
    1px solid #e8edf4;
  border-radius: 15px;
  box-shadow:
    0 3px 14px
    rgba(16,24,39,.035);
}

.panel {
  padding: 24px;
}

.panel h2 {
  margin-top: 0;
  font-size: 18px;
}

.stat-grid {
  display: grid;
  grid-template-columns:
    repeat(
      4,
      minmax(0,1fr)
    );
  gap: 16px;
}

.stat-card {
  padding: 20px;
}

.stat-card span {
  display: block;
  color: #667085;
  font-size: 13px;
}

.stat-card strong {
  display: block;
  margin-top: 10px;
  font-size: 25px;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.tag {
  padding: 7px 10px;
  border-radius: 999px;
  background: #f2f4f7;
  font-size: 12px;
  font-weight: 600;
}

.login-page {
  min-height: 100vh;
  display: grid;
  grid-template-columns:
    minmax(360px, 1fr)
    minmax(420px, .8fr);
}

.login-brand {
  padding: 72px;
  display: flex;
  align-items: flex-end;
  background: #101827;
  color: white;
}

.login-brand > div {
  max-width: 650px;
}

.login-brand h1 {
  margin: 14px 0;
  font-size:
    clamp(
      40px,
      5vw,
      72px
    );
  line-height: .98;
  letter-spacing: -.05em;
}

.login-brand p {
  max-width: 600px;
  margin: 20px 0 0;
  color: #cbd5e1;
  font-size: 17px;
  line-height: 1.7;
}

.login-brand .eyebrow {
  color: #9ca8bb;
}

.login-panel {
  padding: 48px;
  display: grid;
  place-items: center;
  background: #f8fafc;
}

.login-card {
  width: min(
    100%,
    430px
  );
  padding: 34px;
  display: grid;
  gap: 21px;
  background: white;
  border:
    1px solid #e5eaf1;
  border-radius: 20px;
  box-shadow:
    0 22px 60px
    rgba(15,23,42,.07);
}

.login-card h2 {
  margin: 6px 0;
  font-size: 29px;
}

label {
  display: grid;
  gap: 8px;
  font-size: 13px;
  font-weight: 700;
}

input {
  width: 100%;
  padding: 12px 13px;
  border:
    1px solid #d0d5dd;
  border-radius: 9px;
  outline: none;
  background: white;
}

input:focus {
  border-color: #667085;
  box-shadow:
    0 0 0 3px
    rgba(102,112,133,.1);
}

.primary-button,
.secondary-button {
  border: 0;
  cursor: pointer;
  border-radius: 9px;
  font-weight: 700;
}

.primary-button {
  min-height: 44px;
  padding: 10px 16px;
  background: #101827;
  color: white;
}

.primary-button:disabled {
  opacity: .6;
  cursor: default;
}

.secondary-button {
  width: 100%;
  padding: 9px 12px;
  margin-top: 14px;
  color: white;
  background:
    rgba(255,255,255,.1);
}

.link-button {
  display: inline-grid;
  place-items: center;
}

.alert {
  padding: 11px 13px;
  border-radius: 9px;
  font-size: 13px;
}

.alert.error {
  background: #fff1f0;
  color: #b42318;
  border:
    1px solid #fecdca;
}

.muted {
  color: #667085;
}

.screen-center {
  min-height: 100vh;
  padding: 32px;
  display: grid;
  place-items: center;
  text-align: center;
  background: #f8fafc;
}

.loader {
  width: 34px;
  height: 34px;
  margin: auto;
  border:
    3px solid #e5e7eb;
  border-top-color:
    #111827;
  border-radius: 50%;
  animation:
    spin .8s linear infinite;
}

@keyframes spin {
  to {
    transform:
      rotate(360deg);
  }
}

.error-card {
  width:
    min(100%, 460px);
  padding: 36px;
  background: white;
  border:
    1px solid #e8edf4;
  border-radius: 18px;
}

.error-code {
  font-size: 48px;
  font-weight: 800;
}

.json-preview {
  overflow: auto;
  padding: 18px;
  margin: 0;
  border-radius: 10px;
  background: #101827;
  color: #e5e7eb;
  font-size: 12px;
}

@media (
  max-width: 1000px
) {
  .stat-grid {
    grid-template-columns:
      repeat(
        2,
        minmax(0,1fr)
      );
  }

  .login-page {
    grid-template-columns:
      1fr;
  }

  .login-brand {
    min-height: 340px;
    padding: 40px;
  }
}

@media (
  max-width: 760px
) {
  .app-shell {
    display: block;
  }

  .sidebar {
    position: static;
    min-height: auto;
    height: auto;
  }

  .navigation {
    grid-template-columns:
      repeat(
        2,
        minmax(0,1fr)
      );
  }

  .topbar,
  .content {
    padding-left: 18px;
    padding-right: 18px;
  }

  .stat-grid {
    grid-template-columns:
      1fr;
  }

  .login-panel {
    padding: 24px;
  }
}

/* ==========================================================
   DASHBOARD
   ========================================================== */

.dashboard-grid {
  display: grid;
  grid-template-columns:
    repeat(
      2,
      minmax(0, 1fr)
    );
  gap: 18px;
}

.metric-list {
  display: grid;
  gap: 14px;
}

.metric-list > div {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12px;
  border-bottom:
    1px solid #eef1f5;
}

.metric-list > div:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.metric-list span {
  color: #667085;
  font-size: 14px;
}

.metric-list strong {
  font-size: 17px;
}

.progress-track {
  height: 8px;
  margin-top: 22px;
  background: #edf1f5;
  border-radius: 999px;
  overflow: hidden;
}

.progress-value {
  height: 100%;
  background: #101827;
  border-radius: inherit;
}

.big-number {
  font-size: 46px;
  font-weight: 800;
  letter-spacing: -.04em;
}


/* ==========================================================
   REFERENTIEL
   ========================================================== */

.referentiel-stats {
  display: grid;
  grid-template-columns:
    repeat(
      5,
      minmax(0, 1fr)
    );
  gap: 12px;
}

.referentiel-stats > div {
  background: white;
  border:
    1px solid #e8edf4;
  border-radius: 13px;
  padding: 17px;
}

.referentiel-stats strong {
  display: block;
  font-size: 25px;
}

.referentiel-stats span {
  display: block;
  margin-top: 5px;
  color: #667085;
  font-size: 12px;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  align-items: center;
}

.tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.tab {
  border: 0;
  background: transparent;
  padding: 9px 12px;
  border-radius: 8px;
  cursor: pointer;
  color: #667085;
  font-weight: 650;
}

.tab.active {
  background: #101827;
  color: white;
}

.search-input {
  width: 260px;
}

.crud-layout {
  display: grid;
  grid-template-columns:
    minmax(0, 1fr)
    360px;
  gap: 18px;
  align-items: start;
}

.table-panel {
  overflow-x: auto;
  padding: 0;
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
}

th {
  padding: 13px 16px;
  background: #f8fafc;
  border-bottom:
    1px solid #e8edf4;
  text-align: left;
  color: #667085;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .04em;
}

td {
  padding: 14px 16px;
  border-bottom:
    1px solid #eef1f5;
}

tbody tr:hover {
  background: #fafbfc;
}

.status {
  display: inline-flex;
  padding: 5px 8px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
}

.status.active {
  background: #ecfdf3;
  color: #027a48;
}

.status.inactive {
  background: #f2f4f7;
  color: #667085;
}

.action-buttons {
  display: flex;
  gap: 6px;
}

.action-buttons button,
.text-button {
  border: 0;
  background: transparent;
  cursor: pointer;
  font-size: 12px;
  font-weight: 700;
  color: #344054;
}

.action-buttons .danger-link {
  color: #b42318;
}

.form-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.form-heading h2 {
  margin: 0;
}

.form-grid {
  display: grid;
  gap: 16px;
  margin-top: 22px;
}

select {
  width: 100%;
  padding: 12px 13px;
  border:
    1px solid #d0d5dd;
  border-radius: 9px;
  background: white;
  font: inherit;
  outline: none;
}

select:focus {
  border-color: #667085;
  box-shadow:
    0 0 0 3px
    rgba(102,112,133,.1);
}

.checkbox-row {
  display: flex;
  align-items: center;
  gap: 9px;
}

.checkbox-row input {
  width: auto;
}

.alert.success {
  background: #ecfdf3;
  color: #027a48;
  border:
    1px solid #abefc6;
}

@media (
  max-width: 1200px
) {
  .referentiel-stats {
    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );
  }

  .crud-layout {
    grid-template-columns:
      1fr;
  }
}

@media (
  max-width: 760px
) {
  .dashboard-grid {
    grid-template-columns:
      1fr;
  }

  .referentiel-stats {
    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );
  }

  .toolbar {
    align-items: stretch;
    flex-direction: column;
  }

  .search-input {
    width: 100%;
  }
}

/* ==========================================================
   ENSEIGNEMENTS
   ========================================================== */

.table-subtitle {
  display: block;
  margin-top: 4px;
  color: #667085;
  font-size: 11px;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  align-items: flex-start;
}

.section-title-row h2 {
  margin-bottom: 4px;
}

.counter-badge {
  min-width: 34px;
  height: 34px;
  padding: 0 10px;
  border-radius: 999px;
  display: inline-grid;
  place-items: center;
  background: #101827;
  color: white;
  font-weight: 800;
}

.pending-grid {
  display: grid;
  grid-template-columns:
    repeat(
      3,
      minmax(0, 1fr)
    );
  gap: 14px;
  margin-top: 20px;
}

.session-card {
  padding: 18px;
  border: 1px solid #e8edf4;
  border-radius: 13px;
  background: #fbfcfd;
}

.session-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
}

.session-card p {
  color: #667085;
}

.session-details {
  display: grid;
  grid-template-columns:
    repeat(
      3,
      minmax(0, 1fr)
    );
  gap: 8px;
  margin: 16px 0;
}

.session-details div {
  padding: 9px;
  border-radius: 8px;
  background: white;
  border: 1px solid #eef1f5;
}

.session-details dt {
  font-size: 10px;
  color: #667085;
  text-transform: uppercase;
  letter-spacing: .04em;
}

.session-details dd {
  margin: 4px 0 0;
  font-size: 12px;
  font-weight: 700;
}

.session-content {
  min-height: 45px;
  font-size: 13px;
}

.session-actions {
  display: flex;
  gap: 8px;
  margin-top: 16px;
}

.approve-button,
.reject-button {
  flex: 1;
  min-height: 38px;
  border: 0;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 700;
}

.approve-button {
  background: #ecfdf3;
  color: #027a48;
}

.reject-button {
  background: #fff1f0;
  color: #b42318;
}

.danger-text-button {
  border: 0;
  background: transparent;
  color: #b42318;
  font-weight: 700;
  cursor: pointer;
}

.status.pending,
.session-status.declaree {
  background: #fffaeb;
  color: #b54708;
}

.session-status.validee {
  background: #ecfdf3;
  color: #027a48;
}

.session-status.rejetee {
  background: #fff1f0;
  color: #b42318;
}

.session-status.annulee {
  background: #f2f4f7;
  color: #475467;
}


/* ==========================================================
   ESPACE ENSEIGNANT
   ========================================================== */

.teacher-space-grid {
  display: grid;
  grid-template-columns:
    minmax(0, 1fr)
    minmax(320px, .75fr);
  gap: 18px;
  align-items: start;
}

.two-columns {
  display: grid;
  grid-template-columns:
    repeat(
      2,
      minmax(0, 1fr)
    );
  gap: 12px;
}

textarea {
  width: 100%;
  padding: 12px 13px;
  border: 1px solid #d0d5dd;
  border-radius: 9px;
  resize: vertical;
  font: inherit;
  outline: none;
}

textarea:focus {
  border-color: #667085;
  box-shadow:
    0 0 0 3px
    rgba(102,112,133,.1);
}

.assignment-list {
  display: grid;
  gap: 10px;
}

.assignment-card {
  display: grid;
  gap: 5px;
  padding: 14px;
  border: 1px solid #e8edf4;
  border-radius: 10px;
}

.assignment-card span {
  color: #475467;
  font-size: 13px;
}

.assignment-card small {
  color: #98a2b3;
}

@media (
  max-width: 1150px
) {
  .pending-grid {
    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );
  }

  .teacher-space-grid {
    grid-template-columns:
      1fr;
  }
}

@media (
  max-width: 700px
) {
  .pending-grid {
    grid-template-columns:
      1fr;
  }

  .two-columns {
    grid-template-columns:
      1fr;
  }

  .session-details {
    grid-template-columns:
      1fr;
  }
}

/* ==========================================================
   ELIGIBILITE ET DIPLOMES
   ========================================================== */

.eligibility-columns {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 18px;
  align-items: start;
}

.eligibility-form {
  display: grid;
  grid-template-columns:
    repeat(4, minmax(0, 1fr));
  gap: 14px;
  margin-top: 20px;
}

.eligibility-form label {
  display: grid;
  gap: 7px;
  font-size: 12px;
  font-weight: 700;
  color: #344054;
}

.eligibility-observations {
  grid-column:
    span 2;
}

.counter-badge.warning {
  background: #b54708;
}

.empty-state {
  margin: 18px 0 0;
  padding: 24px;
  border: 1px dashed #d0d5dd;
  border-radius: 10px;
  color: #667085;
  text-align: center;
}

.table-scroll {
  width: 100%;
  overflow-x: auto;
}

.decision-status.admis {
  background: #ecfdf3;
  color: #027a48;
}

.decision-status.en_attente {
  background: #fffaeb;
  color: #b54708;
}

.decision-status.ajourne {
  background: #fff7ed;
  color: #c2410c;
}

.decision-status.refuse {
  background: #fff1f0;
  color: #b42318;
}

.diploma-status.demandee {
  background: #eef4ff;
  color: #3538cd;
}

.diploma-status.en_verification {
  background: #fffaeb;
  color: #b54708;
}

.diploma-status.a_corriger {
  background: #fff7ed;
  color: #c2410c;
}

.diploma-status.validee,
.diploma-status.generee,
.diploma-status.signee {
  background: #ecfdf3;
  color: #027a48;
}

.diploma-status.disponible {
  background: #ecfdf3;
  color: #027a48;
  font-weight: 800;
}

.diploma-status.retiree {
  background: #f2f4f7;
  color: #344054;
}

.diploma-status.rejetee,
.diploma-status.annulee {
  background: #fff1f0;
  color: #b42318;
}

.approve-button.compact,
.reject-button.compact {
  flex: initial;
  min-height: 34px;
  padding: 7px 11px;
}

.student-eligibility-grid {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 14px;
  margin-top: 18px;
}

.eligibility-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 18px;
  border: 1px solid #e7edf4;
  border-radius: 13px;
}

.eligibility-card.eligible {
  border-left:
    4px solid #12b76a;
}

.eligibility-card h3 {
  margin: 10px 0 4px;
}

.eligibility-card p {
  margin: 0;
  color: #667085;
  font-size: 13px;
}

.primary-button:disabled {
  opacity: .55;
  cursor: not-allowed;
}

@media (
  max-width: 1100px
) {
  .eligibility-form {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .eligibility-columns {
    grid-template-columns:
      1fr;
  }

  .student-eligibility-grid {
    grid-template-columns:
      1fr;
  }
}

@media (
  max-width: 700px
) {
  .eligibility-form {
    grid-template-columns:
      1fr;
  }

  .eligibility-observations {
    grid-column:
      auto;
  }

  .eligibility-card {
    align-items: stretch;
    flex-direction: column;
  }
}

/* ==========================================================
   PEDAGOGIE ET QHSE
   ========================================================== */

.pedagogy-session-grid {
  display: grid;
  grid-template-columns:
    repeat(3, minmax(0, 1fr));
  gap: 14px;
  margin-top: 20px;
}

.pedagogy-session-card {
  padding: 18px;
  border: 1px solid #e6ebf2;
  border-radius: 13px;
  background: #fbfcfd;
}

.pedagogy-session-info {
  display: grid;
  grid-template-columns:
    repeat(3, minmax(0, 1fr));
  gap: 8px;
  margin: 18px 0;
}

.pedagogy-session-info div {
  display: grid;
  gap: 4px;
  padding: 9px;
  background: white;
  border: 1px solid #eef1f5;
  border-radius: 8px;
}

.pedagogy-session-info span,
.session-description span {
  font-size: 10px;
  color: #667085;
  text-transform: uppercase;
}

.pedagogy-session-info strong {
  font-size: 12px;
}

.session-description p {
  margin-bottom: 0;
  line-height: 1.5;
}

.analysis-controls {
  display: grid;
  grid-template-columns:
    220px minmax(280px, 1fr) auto;
  gap: 14px;
  align-items: end;
  margin-top: 20px;
}

.analysis-controls label {
  display: grid;
  gap: 7px;
  font-size: 12px;
  font-weight: 700;
}

.analysis-results {
  display: grid;
  grid-template-columns:
    repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-top: 20px;
}

.analysis-result-card {
  display: grid;
  gap: 7px;
  padding: 15px;
  border: 1px solid #e8edf4;
  border-radius: 10px;
  background: #fbfcfd;
}

.analysis-result-card span {
  color: #667085;
  font-size: 11px;
}

.analysis-result-card strong {
  font-size: 19px;
  overflow-wrap: anywhere;
}

.qhse-toolbar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
}

.qhse-toolbar label {
  display: grid;
  gap: 7px;
  min-width: 260px;
  font-size: 12px;
  font-weight: 700;
}

.qhse-alert-grid {
  display: grid;
  grid-template-columns:
    repeat(3, minmax(0, 1fr));
  gap: 14px;
  margin-top: 20px;
}

.qhse-alert-card {
  padding: 17px;
  border: 1px solid #e8edf4;
  border-left-width: 4px;
  border-radius: 12px;
}

.qhse-alert-card.warning {
  border-left-color: #f79009;
}

.qhse-alert-card.critical {
  border-left-color: #d92d20;
}

.qhse-alert-card.information {
  border-left-color: #6172f3;
}

.qhse-alert-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.qhse-alert-type {
  font-size: 10px;
  font-weight: 800;
  color: #667085;
  text-transform: uppercase;
}

.qhse-alert-card h3 {
  margin: 14px 0 7px;
  font-size: 16px;
}

.qhse-alert-card p {
  color: #667085;
  font-size: 13px;
  line-height: 1.5;
}

.qhse-alert-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 14px;
}

.qhse-alert-meta span {
  padding: 5px 8px;
  background: #f2f4f7;
  border-radius: 6px;
  color: #475467;
  font-size: 10px;
  font-weight: 700;
}

.qhse-status {
  background: #f2f4f7;
  color: #344054;
}

.qhse-analysis-columns {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.qhse-generic-list {
  display: grid;
  gap: 8px;
  margin-top: 17px;
}

.qhse-generic-row {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  padding: 11px 12px;
  border: 1px solid #eef1f5;
  border-radius: 8px;
}

.qhse-generic-row span {
  color: #667085;
  font-size: 12px;
}

.qhse-ok-state {
  margin-top: 20px;
}

@media (max-width: 1150px) {
  .pedagogy-session-grid,
  .qhse-alert-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .analysis-results {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 800px) {
  .pedagogy-session-grid,
  .qhse-alert-grid,
  .qhse-analysis-columns,
  .analysis-results {
    grid-template-columns:
      1fr;
  }

  .analysis-controls {
    grid-template-columns:
      1fr;
  }

  .pedagogy-session-info {
    grid-template-columns:
      1fr;
  }

  .qhse-toolbar {
    align-items: stretch;
    flex-direction: column;
  }

  .qhse-toolbar label {
    min-width: 0;
  }
}

/* ==========================================================
   ADMINISTRATION AUDIT NOTIFICATIONS
   ========================================================== */

.security-columns {
  display: grid;
  grid-template-columns:
    .8fr 1.2fr;
  gap: 18px;
  align-items: start;
}

.security-list {
  display: grid;
  gap: 9px;
  margin-top: 18px;
}

.security-item {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  padding: 13px;
  border: 1px solid #e8edf4;
  border-radius: 9px;
}

.security-item p {
  margin: 5px 0 0;
  color: #667085;
  font-size: 12px;
}

.security-item > span {
  color: #667085;
  font-size: 11px;
}

.permission-grid {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 9px;
  margin-top: 18px;
}

.permission-card {
  padding: 12px;
  border: 1px solid #e8edf4;
  border-radius: 9px;
}

.permission-card strong {
  font-size: 11px;
}

.permission-card p {
  margin: 7px 0 0;
  color: #667085;
  font-size: 11px;
}

.role-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}

.role-badge {
  padding: 4px 7px;
  border-radius: 6px;
  background: #eef4ff;
  color: #3538cd;
  font-size: 9px;
  font-weight: 800;
}

.audit-toolbar {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  align-items: flex-end;
}

.audit-filters {
  display: flex;
  gap: 8px;
}

.http-method {
  display: inline-flex;
  padding: 4px 7px;
  border-radius: 6px;
  background: #f2f4f7;
  font-size: 9px;
  font-weight: 900;
}

.method-post {
  background: #ecfdf3;
  color: #027a48;
}

.method-patch,
.method-put {
  background: #fffaeb;
  color: #b54708;
}

.method-delete {
  background: #fff1f0;
  color: #b42318;
}

.audit-failed {
  background: #fff1f0;
  color: #b42318;
}

.notification-list {
  display: grid;
  gap: 10px;
}

.notification-card {
  display: grid;
  grid-template-columns:
    42px minmax(0, 1fr);
  gap: 14px;
  padding: 17px;
  background: white;
  border: 1px solid #e8edf4;
  border-radius: 12px;
}

.notification-card.unread {
  border-left:
    4px solid #6172f3;
  background: #fbfcff;
}

.notification-icon {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #f2f4f7;
  color: #344054;
  font-weight: 900;
}

.notification-heading {
  display: flex;
  justify-content: space-between;
  gap: 12px;
}

.notification-heading strong {
  display: block;
}

.notification-heading small {
  display: block;
  margin-top: 3px;
  color: #98a2b3;
}

.notification-content p {
  margin: 10px 0;
  color: #667085;
}

.notification-actions {
  display: flex;
  gap: 8px;
}

.unread-dot {
  width: 8px;
  height: 8px;
  flex: 0 0 8px;
  border-radius: 50%;
  background: #6172f3;
}

@media (max-width: 900px) {
  .security-columns {
    grid-template-columns:
      1fr;
  }

  .permission-grid {
    grid-template-columns:
      1fr;
  }

  .audit-toolbar {
    align-items: stretch;
    flex-direction: column;
  }

  .audit-filters {
    flex-direction: column;
  }
}

@media (max-width: 650px) {
  .notification-card {
    grid-template-columns:
      1fr;
  }
}

/* REFERENTIEL PREMIUM */

/* ============================================================
   REFERENTIEL PREMIUM
   ============================================================ */

.referentiel-premium {
  --ref-blue: #146fe8;
  --ref-blue-dark: #0759c5;
  --ref-blue-soft: #eaf3ff;

  --ref-green: #13a76b;
  --ref-green-soft: #e7f8f0;

  --ref-purple: #7b47e8;
  --ref-purple-soft: #f1eaff;

  --ref-orange: #f29118;
  --ref-orange-soft: #fff1df;

  --ref-red: #ee4d5a;
  --ref-red-soft: #fdebed;

  --ref-text: #0b1833;
  --ref-muted: #6f7f98;
  --ref-border: #e3eaf4;
  --ref-bg: #f4f7fb;
  --ref-card: #ffffff;

  gap: 18px;
}

/* ------------------------------------------------------------
   HEADER
   ------------------------------------------------------------ */

.referentiel-premium .page-header {
  position: relative;
  min-height: 82px;

  display: grid;
  align-content: center;

  padding:
    8px
    410px
    8px
    70px;

  margin-bottom: 2px;
}

.referentiel-premium .page-header::before {
  content: "▤";

  position: absolute;

  left: 0;
  top: 8px;

  width: 52px;
  height: 52px;

  display: grid;
  place-items: center;

  border-radius: 15px;

  background:
    linear-gradient(
      135deg,
      #4090ff,
      #1266d8
    );

  color: #ffffff;

  font-size: 25px;
  font-weight: 700;

  box-shadow:
    0 10px 24px
    rgba(20, 111, 232, .22);
}

.referentiel-premium .page-header::after {
  content:
    "Le référentiel garantit la cohérence des données académiques. Commencez par les filières, puis les formations, niveaux, classes et cours.";

  position: absolute;

  top: 4px;
  right: 0;

  width: 350px;

  box-sizing: border-box;

  padding:
    13px
    16px
    13px
    42px;

  border:
    1px solid
    #d7e8ff;

  border-radius: 12px;

  background:
    linear-gradient(
      135deg,
      #eef6ff,
      #e8f2ff
    );

  color: #376187;

  font-size: 11px;
  line-height: 1.45;
}

.referentiel-premium .page-header h1 {
  margin: 0 0 5px;

  color: var(--ref-text);

  font-size: 30px;
  line-height: 1.1;
  letter-spacing: -.035em;
}

.referentiel-premium .page-header p {
  margin: 0;

  color: var(--ref-muted);

  font-size: 13px;
}

/* ------------------------------------------------------------
   KPI REFERENTIEL
   ------------------------------------------------------------ */

.referentiel-premium .referentiel-stats {
  display: grid;

  grid-template-columns:
    repeat(
      5,
      minmax(0, 1fr)
    );

  gap: 12px;
}

.referentiel-premium .referentiel-stats > * {
  position: relative;

  min-height: 105px;

  box-sizing: border-box;

  display: flex;
  flex-direction: column;
  justify-content: center;

  padding:
    17px
    15px
    17px
    76px;

  border:
    1px solid
    var(--ref-border);

  border-radius: 15px;

  background:
    var(--ref-card);

  box-shadow:
    0 7px 25px
    rgba(20, 45, 85, .045);

  transition:
    transform .16s ease,
    border-color .16s ease,
    box-shadow .16s ease;
}

.referentiel-premium .referentiel-stats > *:hover {
  transform:
    translateY(-2px);

  border-color:
    #bfd5ef;

  box-shadow:
    0 12px 28px
    rgba(20, 45, 85, .08);
}

.referentiel-premium .referentiel-stats > *::before {
  position: absolute;

  left: 17px;
  top: 50%;

  width: 44px;
  height: 44px;

  transform:
    translateY(-50%);

  display: grid;
  place-items: center;

  border-radius: 13px;

  font-size: 19px;
  font-weight: 800;
}

.referentiel-premium .referentiel-stats > *:nth-child(1)::before {
  content: "▥";

  background:
    var(--ref-blue-soft);

  color:
    var(--ref-blue);
}

.referentiel-premium .referentiel-stats > *:nth-child(2)::before {
  content: "◇";

  background:
    var(--ref-green-soft);

  color:
    var(--ref-green);
}

.referentiel-premium .referentiel-stats > *:nth-child(3)::before {
  content: "▱";

  background:
    var(--ref-purple-soft);

  color:
    var(--ref-purple);
}

.referentiel-premium .referentiel-stats > *:nth-child(4)::before {
  content: "◉";

  background:
    var(--ref-orange-soft);

  color:
    var(--ref-orange);
}

.referentiel-premium .referentiel-stats > *:nth-child(5)::before {
  content: "▤";

  background:
    var(--ref-red-soft);

  color:
    var(--ref-red);
}

.referentiel-premium .referentiel-stats strong,
.referentiel-premium .referentiel-stats .value {
  margin-bottom: 3px;

  color:
    var(--ref-text);

  font-size: 27px;
  line-height: 1;
  letter-spacing: -.03em;
}

.referentiel-premium .referentiel-stats span,
.referentiel-premium .referentiel-stats small,
.referentiel-premium .referentiel-stats p {
  color:
    var(--ref-muted);

  font-size: 11px;
}

/* ------------------------------------------------------------
   TOOLBAR + ONGLETS
   ------------------------------------------------------------ */

.referentiel-premium .toolbar {
  min-height: 64px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 18px;

  padding:
    8px
    12px;

  border:
    1px solid
    var(--ref-border);

  border-radius: 15px;

  background:
    #ffffff;

  box-shadow:
    0 7px 24px
    rgba(20, 45, 85, .035);
}

.referentiel-premium .tabs {
  display: flex;
  align-items: center;

  gap: 4px;

  padding: 0;

  border: 0;

  background:
    transparent;
}

.referentiel-premium .tab {
  position: relative;

  min-height: 44px;

  display: inline-flex;
  align-items: center;

  padding:
    0
    17px;

  border: 0;
  border-radius: 9px;

  background:
    transparent;

  color:
    #637694;

  font-size: 12px;
  font-weight: 700;

  cursor: pointer;

  transition:
    color .15s ease,
    background .15s ease;
}

.referentiel-premium .tab:hover {
  color:
    var(--ref-blue-dark);

  background:
    #f5f9ff;
}

.referentiel-premium .tab.active {
  color:
    var(--ref-blue-dark);

  background:
    #eef5ff;
}

.referentiel-premium .tab.active::after {
  content: "";

  position: absolute;

  left: 14px;
  right: 14px;
  bottom: -9px;

  height: 2px;

  border-radius: 999px;

  background:
    var(--ref-blue);
}

.referentiel-premium .search-input {
  width: 260px;
  min-height: 42px;

  box-sizing: border-box;

  padding:
    0
    14px;

  border:
    1px solid
    #d9e3ef;

  border-radius: 10px;

  background:
    #fbfdff;

  color:
    var(--ref-text);

  outline: none;

  transition:
    border-color .15s ease,
    box-shadow .15s ease;
}

.referentiel-premium .search-input:focus {
  border-color:
    #8dbdf7;

  box-shadow:
    0 0 0 3px
    rgba(20, 111, 232, .09);

  background:
    #ffffff;
}

/* ------------------------------------------------------------
   LAYOUT TABLE + FORM
   ------------------------------------------------------------ */

.referentiel-premium .crud-layout {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    325px;

  align-items: start;

  gap: 16px;
}

.referentiel-premium .panel {
  border:
    1px solid
    var(--ref-border);

  border-radius: 15px;

  background:
    #ffffff;

  box-shadow:
    0 7px 25px
    rgba(20, 45, 85, .04);
}

.referentiel-premium .table-panel {
  position: relative;

  min-height: 390px;

  overflow: hidden;
}

.referentiel-premium .table-panel::before {
  content:
    "Liste des éléments";

  display: block;

  padding:
    18px
    18px
    14px;

  border-bottom:
    1px solid
    #edf1f6;

  color:
    var(--ref-text);

  font-size: 15px;
  font-weight: 800;
}

/* Empty state moderne */
.referentiel-premium .table-panel:has(
  tbody:not(:has(tr))
)::after {
  content:
    "Aucune donnée enregistrée\A Commencez par ajouter votre premier élément au référentiel académique.";

  white-space: pre-line;

  position: absolute;

  left: 50%;
  top: 58%;

  transform:
    translate(-50%, -50%);

  width: min(
    440px,
    75%
  );

  box-sizing: border-box;

  padding:
    64px
    20px
    24px;

  border-radius: 16px;

  background:
    radial-gradient(
      circle at 50% 25px,
      #edf3fa 0 31px,
      transparent 32px
    );

  color:
    #7889a1;

  text-align: center;

  font-size: 12px;
  line-height: 1.7;
}

/* ------------------------------------------------------------
   TABLE
   ------------------------------------------------------------ */

.referentiel-premium table {
  width: 100%;

  border-collapse:
    collapse;

  background:
    #ffffff;
}

.referentiel-premium thead {
  background:
    #f7f9fc;
}

.referentiel-premium th {
  padding:
    13px
    14px;

  border-bottom:
    1px solid
    #e6edf5;

  color:
    #667895;

  text-align: left;

  font-size: 10px;
  font-weight: 800;

  letter-spacing: .045em;
  text-transform: uppercase;
}

.referentiel-premium td {
  padding:
    14px;

  border-bottom:
    1px solid
    #edf1f6;

  color:
    #263c59;

  font-size: 12px;

  vertical-align: middle;
}

.referentiel-premium tbody tr {
  transition:
    background .14s ease;
}

.referentiel-premium tbody tr:hover {
  background:
    #f8fbff;
}

/* ------------------------------------------------------------
   STATUS
   ------------------------------------------------------------ */

.referentiel-premium .status {
  display: inline-flex;
  align-items: center;

  min-height: 25px;

  padding:
    0
    9px;

  border-radius: 999px;

  background:
    #e7f8ef;

  color:
    #168356;

  font-size: 10px;
  font-weight: 800;
}

.referentiel-premium .status.inactive,
.referentiel-premium .status.disabled {
  background:
    #f0f2f5;

  color:
    #768399;
}

/* ------------------------------------------------------------
   FORMULAIRE DROIT
   ------------------------------------------------------------ */

.referentiel-premium .crud-layout > .panel:last-child {
  position: sticky;

  top: 20px;

  padding: 20px;

  overflow: hidden;
}

.referentiel-premium .crud-layout > .panel:last-child::before {
  content: "+";

  float: left;

  width: 37px;
  height: 37px;

  margin:
    -2px
    11px
    13px
    0;

  display: grid;
  place-items: center;

  border-radius: 10px;

  background:
    linear-gradient(
      135deg,
      #4091ff,
      #1468dd
    );

  color:
    #ffffff;

  font-size: 24px;
  font-weight: 300;

  box-shadow:
    0 8px 18px
    rgba(20, 104, 221, .22);
}

.referentiel-premium .crud-layout > .panel:last-child h2,
.referentiel-premium .crud-layout > .panel:last-child h3 {
  margin:
    0
    0
    19px;

  color:
    var(--ref-text);

  font-size: 17px;
  line-height: 1.35;
}

.referentiel-premium .form-grid {
  clear: both;

  display: grid;

  gap: 13px;
}

.referentiel-premium .form-grid label {
  display: grid;

  gap: 6px;

  color:
    #243854;

  font-size: 11px;
  font-weight: 750;
}

.referentiel-premium .form-grid input,
.referentiel-premium .form-grid select,
.referentiel-premium .form-grid textarea {
  width: 100%;
  min-height: 42px;

  box-sizing: border-box;

  padding:
    9px
    11px;

  border:
    1px solid
    #d6e0ec;

  border-radius: 9px;

  background:
    #ffffff;

  color:
    var(--ref-text);

  font: inherit;

  outline: none;

  transition:
    border-color .15s ease,
    box-shadow .15s ease;
}

.referentiel-premium .form-grid textarea {
  min-height: 86px;

  resize: vertical;
}

.referentiel-premium .form-grid input:hover,
.referentiel-premium .form-grid select:hover,
.referentiel-premium .form-grid textarea:hover {
  border-color:
    #b6c9df;
}

.referentiel-premium .form-grid input:focus,
.referentiel-premium .form-grid select:focus,
.referentiel-premium .form-grid textarea:focus {
  border-color:
    #77aff3;

  box-shadow:
    0 0 0 3px
    rgba(20, 111, 232, .09);
}

/* ------------------------------------------------------------
   BOUTONS
   ------------------------------------------------------------ */

.referentiel-premium button {
  font-family:
    inherit;
}

.referentiel-premium .form-grid button[type="submit"],
.referentiel-premium .primary-button,
.referentiel-premium button.primary {
  min-height: 43px;

  border: 0;

  border-radius: 9px;

  background:
    linear-gradient(
      135deg,
      #1472e8,
      #0759c5
    );

  color:
    #ffffff;

  font-size: 12px;
  font-weight: 800;

  cursor: pointer;

  box-shadow:
    0 8px 18px
    rgba(20, 111, 232, .18);

  transition:
    transform .15s ease,
    box-shadow .15s ease;
}

.referentiel-premium .form-grid button[type="submit"]:hover,
.referentiel-premium .primary-button:hover,
.referentiel-premium button.primary:hover {
  transform:
    translateY(-1px);

  box-shadow:
    0 10px 24px
    rgba(20, 111, 232, .25);
}

.referentiel-premium .action-buttons {
  display: flex;
  align-items: center;

  gap: 6px;
}

.referentiel-premium .action-buttons button {
  min-height: 30px;

  padding:
    0
    9px;

  border:
    1px solid
    #dae4f0;

  border-radius: 7px;

  background:
    #ffffff;

  color:
    #48607f;

  font-size: 10px;
  font-weight: 750;

  cursor: pointer;
}

.referentiel-premium .action-buttons button:hover {
  border-color:
    #aacaf1;

  background:
    #f3f8ff;

  color:
    #1263c9;
}

/* ------------------------------------------------------------
   PETITE BARRE DE CONTEXTE EN BAS
   ------------------------------------------------------------ */

.referentiel-premium::after {
  content:
    "Structure académique • Filières → Formations → Niveaux → Classes → Cours";

  display: block;

  padding:
    14px
    17px;

  border:
    1px solid
    #e2eaf3;

  border-radius:
    13px;

  background:
    linear-gradient(
      90deg,
      #ffffff,
      #f8fbff
    );

  color:
    #718198;

  font-size:
    11px;

  box-shadow:
    0 5px 18px
    rgba(20, 45, 85, .03);
}

/* ------------------------------------------------------------
   RESPONSIVE
   ------------------------------------------------------------ */

@media (
  max-width: 1250px
) {

  .referentiel-premium .page-header {
    padding-right:
      0;
  }

  .referentiel-premium .page-header::after {
    display:
      none;
  }

  .referentiel-premium .referentiel-stats {
    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );
  }

}

@media (
  max-width: 950px
) {

  .referentiel-premium .crud-layout {
    grid-template-columns:
      1fr;
  }

  .referentiel-premium .crud-layout > .panel:last-child {
    position:
      static;
  }

  .referentiel-premium .referentiel-stats {
    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );
  }

  .referentiel-premium .toolbar {
    align-items:
      stretch;

    flex-direction:
      column;
  }

  .referentiel-premium .tabs {
    overflow-x:
      auto;
  }

  .referentiel-premium .search-input {
    width:
      100%;
  }

}

@media (
  max-width: 600px
) {

  .referentiel-premium .page-header {
    padding:
      4px
      0
      4px
      61px;
  }

  .referentiel-premium .page-header h1 {
    font-size:
      25px;
  }

  .referentiel-premium .referentiel-stats {
    grid-template-columns:
      1fr;
  }

  .referentiel-premium .referentiel-stats > * {
    min-height:
      88px;
  }

  .referentiel-premium .tab {
    padding:
      0
      12px;
  }

  .referentiel-premium .table-panel {
    overflow-x:
      auto;
  }

  .referentiel-premium table {
    min-width:
      720px;
  }

}
