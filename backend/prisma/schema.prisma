generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Filiere {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  nom         String
  description String?
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  formations Formation[]
}

model Formation {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  nom         String
  description String?
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  filiereId Int
  filiere   Filiere @relation(fields: [filiereId], references: [id])

  niveaux Niveau[]
}

model Niveau {
  id       Int     @id @default(autoincrement())
  code     String
  nom      String
  ordre    Int
  terminal Boolean @default(false)
  actif    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formationId Int
  formation   Formation @relation(fields: [formationId], references: [id])

  classes Classe[]
  cours   Cours[]

  @@unique([formationId, code])
}

model Classe {
  id    Int     @id @default(autoincrement())
  code  String
  nom   String
  annee String
  actif Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  niveauId Int
  niveau   Niveau @relation(fields: [niveauId], references: [id])

  affectations AffectationEnseignement[]
  inscriptions InscriptionEtudiant[]

  @@unique([niveauId, code, annee])
}

model Cours {
  id            Int     @id @default(autoincrement())
  code          String
  intitule      String
  volumeHoraire Int
  credits       Int
  semestre      Int
  actif         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  niveauId Int
  niveau   Niveau @relation(fields: [niveauId], references: [id])

  affectations AffectationEnseignement[]

  @@unique([niveauId, code])
}

model Enseignant {
  id         Int     @id @default(autoincrement())
  matricule  String  @unique
  nom        String
  prenom     String
  email      String? @unique
  telephone  String?
  specialite String?
  statut     String?
  actif      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  affectations AffectationEnseignement[]
  utilisateur  Utilisateur?
}

model AffectationEnseignement {
  id              Int     @id @default(autoincrement())
  anneeAcademique String
  actif           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enseignantId Int
  coursId      Int
  classeId     Int

  enseignant Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Restrict)
  cours      Cours      @relation(fields: [coursId], references: [id], onDelete: Restrict)
  classe     Classe     @relation(fields: [classeId], references: [id], onDelete: Restrict)

  seances SeanceCours[]

  @@unique([enseignantId, coursId, classeId, anneeAcademique])
  @@index([enseignantId])
  @@index([coursId])
  @@index([classeId])
  @@index([anneeAcademique])
}

enum StatutSeance {
  DECLAREE
  VALIDEE
  REJETEE
  ANNULEE
}

model SeanceCours {
  id           Int          @id @default(autoincrement())
  dateSeance   DateTime
  heureDebut   String
  heureFin     String
  dureeMinutes Int
  contenu      String
  observations String?
  motifRejet   String?
  valideeLe    DateTime?
  rejeteeLe    DateTime?
  statut       StatutSeance @default(DECLAREE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  affectationId Int
  affectation   AffectationEnseignement @relation(fields: [affectationId], references: [id], onDelete: Restrict)

  @@unique([affectationId, dateSeance, heureDebut])
  @@index([affectationId])
  @@index([dateSeance])
  @@index([statut])
}

enum StatutInscription {
  ACTIVE
  SUSPENDUE
  ABANDONNEE
  TERMINEE
}

enum OrigineDossierEtudiant {
  SYSTEME
  IMPORT
  ARCHIVE
  RECONSTITUTION
}

enum StatutVerificationEtudiant {
  NON_VERIFIE
  EN_VERIFICATION
  VERIFIE
  REJETE
}

enum StatutDemandeAncienEtudiant {
  SOUMISE
  EN_VERIFICATION
  COMPLEMENT_REQUIS
  VALIDEE
  REJETEE
}

enum ObjetDemandeAncienEtudiant {
  RECONSTITUTION_DOSSIER
  INTEGRATION_PARCOURS
  DEMANDE_DIPLOME
  ATTESTATION_REUSSITE
  RELEVE_NOTES
  CORRECTION_DONNEES
  AUTRE
}

enum TypePieceAncienEtudiant {
  IDENTITE
  JUSTIFICATIF_ACADEMIQUE
}

model Etudiant {
  id            Int       @id @default(autoincrement())
  matricule     String    @unique
  nom           String
  prenom        String
  dateNaissance      DateTime?
  lieuNaissance       String?
  email               String?   @unique
  telephone           String?
  origineDossier      OrigineDossierEtudiant      @default(SYSTEME)
  statutVerification  StatutVerificationEtudiant  @default(VERIFIE)
  actif               Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inscriptions           InscriptionEtudiant[]
  utilisateur            Utilisateur?
  demandesReconstitution DemandeAncienEtudiant[]
  parcoursHistoriques    ParcoursAcademiqueHistorique[]
}

model DemandeAncienEtudiant {
  id                       Int                         @id @default(autoincrement())
  reference                String                      @unique
  email                    String
  telephone                String
  nom                      String
  prenom                   String
  dateNaissance            DateTime
  lieuNaissance            String
  matriculeDeclare         String?
  etablissementLibelle     String
  departementLibelle       String?
  filiereLibelle           String
  niveauGrade              String
  anneeEntree              Int
  anneeSortie              Int?
  derniereAnneeAcademique  String
  diplomePrepare           String
  diplomeObtenu            Boolean                     @default(false)
  anneeObtention           Int?
  mention                  String?
  dejaSoutenu              Boolean                     @default(false)
  dateSoutenance           DateTime?
  sujetSoutenance          String?
  directeurMemoire         String?
  presidentJury            String?
  numeroPv                 String?
  attestationReussite      Boolean                     @default(false)
  objetDemande             ObjetDemandeAncienEtudiant
  detailsDemande           String?
  statut                   StatutDemandeAncienEtudiant @default(SOUMISE)
  motifTraitement          String?
  traiteePar               String?
  matriculeVerifie         String?
  dateVerification         DateTime?
  dateDecision             DateTime?
  confirmationEnvoyeeLe    DateTime?
  decisionEnvoyeeLe        DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  etudiantId Int?
  etudiant   Etudiant? @relation(fields: [etudiantId], references: [id], onDelete: SetNull)

  pieces              PieceJustificativeAncienEtudiant[]
  parcoursHistorique  ParcoursAcademiqueHistorique?

  @@index([email])
  @@index([matriculeDeclare])
  @@index([statut])
  @@index([objetDemande])
  @@index([createdAt])
}

model PieceJustificativeAncienEtudiant {
  id            Int                    @id @default(autoincrement())
  type          TypePieceAncienEtudiant
  nomOriginal   String
  nomStockage   String
  cheminStockage String
  mimeType      String
  tailleOctets  Int
  createdAt     DateTime               @default(now())

  demandeId Int
  demande   DemandeAncienEtudiant @relation(fields: [demandeId], references: [id], onDelete: Cascade)

  @@index([demandeId])
  @@index([type])
}

model ParcoursAcademiqueHistorique {
  id                      Int      @id @default(autoincrement())
  etablissementLibelle    String
  departementLibelle      String?
  filiereLibelle          String
  niveauGrade             String
  anneeEntree             Int
  anneeSortie             Int?
  derniereAnneeAcademique String
  diplomePrepare          String
  diplomeObtenu           Boolean  @default(false)
  anneeObtention          Int?
  mention                 String?
  dejaSoutenu             Boolean  @default(false)
  dateSoutenance          DateTime?
  sujetSoutenance         String?
  directeurMemoire        String?
  presidentJury           String?
  numeroPv                String?
  source                   OrigineDossierEtudiant @default(RECONSTITUTION)
  verifiePar               String?
  dateVerification         DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  etudiantId Int
  etudiant   Etudiant @relation(fields: [etudiantId], references: [id], onDelete: Restrict)

  sourceDemandeId Int @unique
  sourceDemande   DemandeAncienEtudiant @relation(fields: [sourceDemandeId], references: [id], onDelete: Restrict)

  @@index([etudiantId])
  @@index([anneeEntree])
  @@index([anneeSortie])
}

model InscriptionEtudiant {
  id              Int               @id @default(autoincrement())
  anneeAcademique String
  statut          StatutInscription @default(ACTIVE)
  dateInscription DateTime          @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  etudiantId Int
  classeId   Int

  etudiant             Etudiant              @relation(fields: [etudiantId], references: [id], onDelete: Restrict)
  classe               Classe                @relation(fields: [classeId], references: [id], onDelete: Restrict)
  validationAcademique ValidationAcademique?
  demandeDiplome       DemandeDiplome?

  soutenance Soutenance?

  @@unique([etudiantId, anneeAcademique])
  @@index([etudiantId])
  @@index([classeId])
  @@index([anneeAcademique])
  @@index([statut])
}

enum DecisionAcademique {
  EN_ATTENTE
  ADMIS
  AJOURNE
  REFUSE
}

model ValidationAcademique {
  id               Int                @id @default(autoincrement())
  decision         DecisionAcademique @default(EN_ATTENTE)
  creditsObtenus   Int                @default(0)
  creditsRequis    Int
  stageRequis      Boolean            @default(false)
  stageValide      Boolean            @default(false)
  memoireRequis    Boolean            @default(false)
  memoireValide    Boolean            @default(false)
  dateDeliberation DateTime?
  observations     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inscriptionId Int                 @unique
  inscription   InscriptionEtudiant @relation(fields: [inscriptionId], references: [id], onDelete: Restrict)

  @@index([decision])
}

enum StatutDemandeDiplome {
  DEMANDEE
  EN_VERIFICATION
  A_CORRIGER
  VALIDEE
  REJETEE
  GENEREE
  SIGNEE
  DISPONIBLE
  RETIREE
  ANNULEE
}

model DemandeDiplome {
  id               Int                  @id @default(autoincrement())
  statut           StatutDemandeDiplome @default(DEMANDEE)
  motif            String?
  dateDemande      DateTime             @default(now())
  dateVerification DateTime?
  dateValidation   DateTime?
  dateRejet        DateTime?
  dateAnnulation   DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  inscriptionId Int                 @unique
  inscription   InscriptionEtudiant @relation(fields: [inscriptionId], references: [id], onDelete: Restrict)

  diplome Diplome?

  @@index([statut])
  @@index([dateDemande])
}

model Diplome {
  id          Int    @id @default(autoincrement())
  numero      String @unique
  typeDiplome String
  intitule    String

  matriculeTitulaire String
  nomTitulaire       String
  prenomTitulaire    String

  formationLibelle String
  niveauLibelle    String
  anneeAcademique  String

  dateGeneration    DateTime  @default(now())
  dateSignature     DateTime?
  dateDisponibilite DateTime?
  dateRetrait       DateTime?
  retirePar         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  demandeId Int            @unique
  demande   DemandeDiplome @relation(fields: [demandeId], references: [id], onDelete: Restrict)

  @@index([numero])
  @@index([matriculeTitulaire])
}

model Utilisateur {
  id                       Int       @id @default(autoincrement())
  email                    String    @unique
  motDePasseHash           String
  nomAffichage             String?
  actif                    Boolean   @default(true)
  derniereConnexion        DateTime?
  doitChangerMotDePasse    Boolean   @default(false)
  dateChangementMotDePasse DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  etudiantId   Int? @unique
  enseignantId Int? @unique

  etudiant   Etudiant?   @relation(fields: [etudiantId], references: [id], onDelete: SetNull)
  enseignant Enseignant? @relation(fields: [enseignantId], references: [id], onDelete: SetNull)

  roles         UtilisateurRole[]
  auditLogs     AuditLog[]
  notifications Notification[]
  actualites      Actualite[]

  @@index([email])
  @@index([actif])
}

model Role {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  nom         String
  description String?
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  utilisateurs UtilisateurRole[]
  permissions  RolePermission[]
}

model Permission {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  nom         String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model UtilisateurRole {
  utilisateurId Int
  roleId        Int
  attribueLe    DateTime @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  role        Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([utilisateurId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AuditLog {
  id Int @id @default(autoincrement())

  utilisateurId Int?
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)

  email String?
  roles Json?

  methode     String
  route       String
  action      String
  ressource   String
  ressourceId String?

  adresseIp String?
  userAgent String?

  statusCode    Int
  succes        Boolean
  messageErreur String?
  dureeMs       Int

  createdAt DateTime @default(now())

  @@index([utilisateurId])
  @@index([ressource])
  @@index([action])
  @@index([succes])
  @@index([createdAt])
}

enum TypeNotification {
  INFO
  SUCCES
  ALERTE
  ERREUR
}

model Notification {
  id      Int              @id @default(autoincrement())
  type    TypeNotification @default(INFO)
  titre   String
  message String
  lien    String?
  donnees Json?

  lu   Boolean   @default(false)
  luLe DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  utilisateurId Int
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
  @@index([lu])
  @@index([type])
  @@index([createdAt])
}

enum DecisionSoutenance {
  EN_ATTENTE
  ADMIS
  AJOURNE
  REFUSE
}

enum StatutSoutenance {
  PLANIFIEE
  TENUE
  REPORTEE
  ANNULEE
}

model Soutenance {
  id Int @id @default(autoincrement())

  sujet          String
  dateSoutenance DateTime
  heureDebut     String?
  heureFin       String?
  lieu           String?
  statut         StatutSoutenance   @default(PLANIFIEE)
  decision       DecisionSoutenance @default(EN_ATTENTE)

  note          Float?
  mention       String?
  numeroPv      String?
  presidentJury String?
  membresJury   String?
  observations  String?

  validee        Boolean   @default(false)
  valideePar     String?
  dateValidation DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inscriptionId Int                 @unique
  inscription   InscriptionEtudiant @relation(fields: [inscriptionId], references: [id], onDelete: Restrict)

  @@index([statut])
  @@index([decision])
  @@index([validee])
  @@index([dateSoutenance])
}


model BrandingSettings {
  id              Int      @id
  appName         String   @default("UniPortail Digital")
  appSubtitle     String   @default("Suivi & Évaluation Académique")
  heroTitle       String   @default("Un suivi rigoureux pour une réussite durable")
  heroDescription String   @default("UniPortail Digital centralise la gestion des enseignements, des évaluations, de la scolarité et des diplômes dans une interface unique, sécurisée et collaborative.")
  quoteText       String   @default("L’enseignement est la clé qui ouvre les portes d’un avenir meilleur.")
  logoUrl         String?
  heroImageUrl    String?
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}


enum SourceActualite {
  PEDAGOGIE
  SCOLARITE
  ADMINISTRATION
}

model Actualite {
  id          Int             @id @default(autoincrement())
  titre       String
  resume      String
  contenu     String?
  imageUrl    String?
  source      SourceActualite
  publiee     Boolean         @default(true)
  dateDebut   DateTime        @default(now())
  dateFin     DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  auteurId Int
  auteur   Utilisateur @relation(fields: [auteurId], references: [id], onDelete: Restrict)

  @@index([publiee])
  @@index([dateDebut])
  @@index([dateFin])
  @@index([source])
  @@index([auteurId])
}


enum TypeDemandeDiplomeExterne {
  PREMIERE_DEMANDE
  DUPLICATA
}

enum StatutDemandeDiplomeExterne {
  DEMANDEE
  EN_VERIFICATION
  DISPONIBLE
  REJETEE
}

model DemandeDiplomeExterne {
  id                    Int                          @id @default(autoincrement())
  reference             String                       @unique
  email                 String
  matricule             String?
  nom                   String
  prenom                String
  dateNaissance         DateTime
  anneeObtention        Int
  intituleDiplome       String
  typeDemande           TypeDemandeDiplomeExterne
  statut                StatutDemandeDiplomeExterne @default(DEMANDEE)
  motif                 String?
  traiteePar            String?
  dateValidation        DateTime?
  dateDisponibilite     DateTime?
  confirmationEnvoyeeLe DateTime?
  disponibiliteEnvoyeeLe DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  @@index([email])
  @@index([matricule])
  @@index([statut])
  @@index([dateDisponibilite])
  @@index([createdAt])
}
