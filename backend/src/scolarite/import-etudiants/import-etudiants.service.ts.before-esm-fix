  private lireCellule(
    cell: ExcelJS.Cell,
  ): string {
    if (
      cell.value instanceof Date
    ) {
      const year =
        cell.value.getFullYear();

      const month =
        String(
          cell.value.getMonth() + 1,
        ).padStart(
          2,
          '0',
        );

      const day =
        String(
          cell.value.getDate(),
        ).padStart(
          2,
          '0',
        );

      return (
        year +
        '-' +
        month +
        '-' +
        day
      );
    }

    return this.nettoyer(
      cell.text ||
      cell.value,
    );
  }

  private async analyserFichier(
    buffer: Buffer,
  ): Promise<LigneImport[]> {
    const workbook =
      new ExcelJS.Workbook();

    try {
      await workbook.xlsx.load(
        buffer as any,
      );
    }
    catch {
      throw new BadRequestException(
        'Le fichier Excel est invalide',
      );
    }

    const sheet =
      workbook.worksheets[0];

    if (!sheet) {
      throw new BadRequestException(
        'Le fichier Excel ne contient aucune feuille',
      );
    }

    const headers =
      new Map<string, number>();

    sheet.getRow(1)
      .eachCell(
        (
          cell,
          colNumber,
        ) => {
          headers.set(
            this.nettoyer(
              cell.text,
            ).toLowerCase(),
            colNumber,
          );
        },
      );

    const required = [
      'matricule',
      'nom',
      'prenom',
      'email',
    ];

    for (
      const header of required
    ) {
      if (
        !headers.has(
          header,
        )
      ) {
        throw new BadRequestException(
          'Colonne obligatoire absente : ' +
          header,
        );
      }
    }

    const rows:
      LigneImport[] = [];

    const matriculesFichier =
      new Set<string>();

    const emailsFichier =
      new Set<string>();

    for (
      let rowNumber = 2;
      rowNumber <= sheet.rowCount;
      rowNumber++
    ) {
      const row =
        sheet.getRow(
          rowNumber,
        );

      const read =
        (
          column:
            string,
        ) => {
          const index =
            headers.get(
              column,
            );

          if (!index) {
            return '';
          }

          return this.lireCellule(
            row.getCell(
              index,
            ),
          );
        };

      const matricule =
        read(
          'matricule',
        ).toUpperCase();

      const nom =
        read(
          'nom',
        );

      const prenom =
        read(
          'prenom',
        );

      const dateNaissance =
        read(
          'date_naissance',
        );

      const email =
        read(
          'email',
        ).toLowerCase();

      const telephone =
        read(
          'telephone',
        );

      if (
        !matricule &&
        !nom &&
        !prenom &&
        !email
      ) {
        continue;
      }

      const erreurs:
        string[] = [];

      if (!matricule) {
        erreurs.push(
          'Matricule obligatoire',
        );
      }

      if (!nom) {
        erreurs.push(
          'Nom obligatoire',
        );
      }

      if (!prenom) {
        erreurs.push(
          'PrÃƒÂ©nom obligatoire',
        );
      }

      if (!email) {
        erreurs.push(
          'E-mail obligatoire',
        );
      }
      else if (
        !this.emailValide(
          email,
        )
      ) {
        erreurs.push(
          'Format e-mail invalide',
        );
      }

      if (
        dateNaissance &&
        !this.dateValide(
          dateNaissance,
        )
      ) {
        erreurs.push(
          'Date de naissance invalide',
        );
      }

      if (
        matricule &&
        matriculesFichier.has(
          matricule,
        )
      ) {
        erreurs.push(
          'Matricule en doublon dans le fichier',
        );
      }

      if (
        email &&
        emailsFichier.has(
          email,
        )
      ) {
        erreurs.push(
          'E-mail en doublon dans le fichier',
        );
      }

      if (matricule) {
        matriculesFichier.add(
          matricule,
        );
      }

      if (email) {
        emailsFichier.add(
          email,
        );
      }

      rows.push({
        ligne:
          rowNumber,

        matricule,
        nom,
        prenom,

        dateNaissance:
          dateNaissance ||
          undefined,

        email,

        telephone:
          telephone ||
          undefined,

        erreurs,
      });

      if (
        rows.length > 1000
      ) {
        throw new BadRequestException(
          'Maximum 1000 ÃƒÂ©tudiants par fichier',
        );
      }
    }

    const matricules =
      rows
        .filter(
          (r) =>
            r.matricule,
        )
        .map(
          (r) =>
            r.matricule,
        );

    const emails =
      rows
        .filter(
          (r) =>
            r.email,
        )
        .map(
          (r) =>
            r.email,
        );

    const [
      existingStudents,
      existingUsers,
    ] =
      await Promise.all([
        this.prisma.etudiant.findMany({
          where: {
            OR: [
              {
                matricule: {
                  in:
                    matricules,
                },
              },
              {
                email: {
                  in:
                    emails,
                },
              },
            ],
          },

          select: {
            matricule: true,
            email: true,
          },
        }),

        this.prisma.utilisateur.findMany({
          where: {
            email: {
              in:
                emails,
            },
          },

          select: {
            email: true,
          },
        }),
      ]);

    const matriculesExistants =
      new Set(
        existingStudents.map(
          (e) =>
            e.matricule,
        ),
      );

    const emailsExistants =
      new Set(
        [
          ...existingStudents
            .map(
              (e) =>
                e.email,
            )
            .filter(
              Boolean,
            ),

          ...existingUsers.map(
            (u) =>
              u.email,
          ),
        ] as string[],
      );

    for (
      const row of rows
    ) {
      if (
        matriculesExistants.has(
          row.matricule,
        )
      ) {
        row.erreurs.push(
          'Matricule dÃƒÂ©jÃƒÂ  enregistrÃƒÂ©',
        );
      }

      if (
        emailsExistants.has(
          row.email,
        )
      ) {
        row.erreurs.push(
          'E-mail dÃƒÂ©jÃƒÂ  enregistrÃƒÂ©',
        );
      }
    }

    return rows;
  }

  async analyser(
    file: {
      buffer: Buffer;
      originalname: string;
      size: number;
    },
    meta:
      ImportEtudiantsMetaDto,
  ) {
    if (!file) {
      throw new BadRequestException(
        'Fichier Excel obligatoire',
      );
    }

    if (
      !file.originalname
        .toLowerCase()
        .endsWith(
          '.xlsx',
        )
    ) {
      throw new BadRequestException(
        'Seuls les fichiers .xlsx sont acceptÃƒÂ©s',
      );
    }

    await this.verifierClasse(
      meta.classeId,
    );

    const rows =
      await this.analyserFichier(
        file.buffer,
      );

    const valides =
      rows.filter(
        (row) =>
          row.erreurs.length ===
          0,
      );

    const invalides =
      rows.filter(
        (row) =>
          row.erreurs.length >
          0,
      );

    return {
      classeId:
        meta.classeId,

      anneeAcademique:
        meta.anneeAcademique,

      total:
        rows.length,

      valides:
        valides.length,

      invalides:
        invalides.length,

      lignes:
        rows.map(
          (row) => ({
            ...row,

            statut:
              row.erreurs.length ===
              0
                ? 'VALIDE'
                : 'ERREUR',
          }),
        ),
    };
  }

  async confirmer(
    file: {
      buffer: Buffer;
      originalname: string;
      size: number;
    },
    meta:
      ImportEtudiantsMetaDto,
  ) {
    const analyse =
      await this.analyser(
        file,
        meta,
      );

    const valides =
      analyse.lignes.filter(
        (row) =>
          row.statut ===
          'VALIDE',
      );

    const resultats:
      any[] = [];

    for (
      const row of valides
    ) {
      try {
        const result =
          await this.creerEtudiantComplet({
            matricule:
              row.matricule,

            nom:
              row.nom,

            prenom:
              row.prenom,

            dateNaissance:
              row.dateNaissance,

            email:
              row.email,

            telephone:
              row.telephone,

            classeId:
              meta.classeId,

            anneeAcademique:
              meta.anneeAcademique,

            statut:
              meta.statut ??
              'ACTIVE',
          });

        resultats.push({
          ligne:
            row.ligne,

          matricule:
            row.matricule,

          statut:
            'IMPORTE',

          emailEnvoye:
            result.acces
              .emailEnvoye,

          statutEmail:
            result.acces
              .statutEmail,
        });
      }
      catch (
        error: any
      ) {
        resultats.push({
          ligne:
            row.ligne,

          matricule:
            row.matricule,

          statut:
            'ECHEC',

          erreur:
            error?.message ??
            'Erreur inconnue',
        });
      }
    }

    return {
      analyse: {
        total:
          analyse.total,

        valides:
          analyse.valides,

        invalides:
          analyse.invalides,
      },

      import: {
        importes:
          resultats.filter(
            (r) =>
              r.statut ===
              'IMPORTE',
          ).length,

        echecs:
          resultats.filter(
            (r) =>
              r.statut ===
              'ECHEC',
          ).length,
      },

      lignesInvalides:
        analyse.lignes.filter(
          (row) =>
            row.statut ===
            'ERREUR',
        ),

      resultats,
    };
  }
