type LigneImport = {
  ligne: number;
  matricule: string;
  nom: string;
  prenom: string;
  dateNaissance?: string;
  email: string;
  telephone?: string;
  erreurs: string[];
};

@Injectable()
export class ImportEtudiantsService {
  constructor(
    private readonly prisma:
      PrismaService,

    private readonly config:
      ConfigService,
  ) {}

  private nettoyer(
    value: unknown,
  ): string {
    return String(
      value ?? '',
    ).trim();
  }

  private emailValide(
    email: string,
  ): boolean {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(
      email,
    );
  }

  private dateValide(
    value?: string,
  ): boolean {
    if (!value) {
      return true;
    }

    const date =
      new Date(
        value + 'T00:00:00.000Z',
      );

    return !Number.isNaN(
      date.getTime(),
    );
  }

  private datePrisma(
    value?: string,
  ): Date | undefined {
    if (!value) {
      return undefined;
    }

    return new Date(
      value + 'T00:00:00.000Z',
    );
  }

  private genererMotDePasse(): string {
    return (
      'Tmp-' +
      randomBytes(12)
        .toString('base64url') +
      '!'
    );
  }

  private async verifierClasse(
    classeId: number,
  ) {
    const classe =
      await this.prisma.classe.findUnique({
        where: {
          id: classeId,
        },
      });

    if (!classe) {
      throw new NotFoundException(
        'Classe acadÃƒÂ©mique introuvable',
      );
    }

    return classe;
  }

  private async verifierDisponibilite(
    matricule: string,
    email: string,
  ) {
    const normalizedMatricule =
      matricule
        .trim()
        .toUpperCase();

    const normalizedEmail =
      email
        .trim()
        .toLowerCase();

    const [
      etudiantMatricule,
      etudiantEmail,
      utilisateurEmail,
    ] =
      await Promise.all([
        this.prisma.etudiant.findUnique({
          where: {
            matricule:
              normalizedMatricule,
          },
        }),

        this.prisma.etudiant.findUnique({
          where: {
            email:
              normalizedEmail,
          },
        }),

        this.prisma.utilisateur.findUnique({
          where: {
            email:
              normalizedEmail,
          },
        }),
      ]);

    if (etudiantMatricule) {
      throw new ConflictException(
        'Ce numÃƒÂ©ro de carte ÃƒÂ©tudiant / matricule existe dÃƒÂ©jÃƒÂ ',
      );
    }

    if (
      etudiantEmail ||
      utilisateurEmail
    ) {
      throw new ConflictException(
        'Cette adresse e-mail existe dÃƒÂ©jÃƒÂ ',
      );
    }

    return {
      matricule:
        normalizedMatricule,

      email:
        normalizedEmail,
    };
  }

  private async envoyerAcces(
    email: string,
    nomAffichage: string,
    matricule: string,
    motDePasseTemporaire: string,
  ) {
    const host =
      this.config.get<string>(
        'SMTP_HOST',
      );

    const from =
      this.config.get<string>(
        'SMTP_FROM',
      );

    if (
      !host ||
      !from
    ) {
      return {
        envoye: false,
        statut:
          'SMTP_NON_CONFIGURE',
      };
    }

    const port =
      Number(
        this.config.get<string>(
          'SMTP_PORT',
        ) ?? '587',
      );

    const secure =
      String(
        this.config.get<string>(
          'SMTP_SECURE',
        ) ?? 'false',
      ).toLowerCase() === 'true';

    const user =
      this.config.get<string>(
        'SMTP_USER',
      );

    const password =
      this.config.get<string>(
        'SMTP_PASSWORD',
      );

    const auth =
      user
        ? {
            user,
            pass: password,
          }
        : undefined;

    try {
      const transporter =
        nodemailer.createTransport({
          host,
          port,
          secure,
          auth,
        });

      await transporter.sendMail({
        from,
        to: email,
        subject:
          'CrÃƒÂ©ation de votre compte ÃƒÂ©tudiant',

        text:
          'Bonjour ' +
          nomAffichage +
          ',\n\n' +
          'Votre compte ÃƒÂ©tudiant a ÃƒÂ©tÃƒÂ© crÃƒÂ©ÃƒÂ©.\n\n' +
          'Matricule / numÃƒÂ©ro de carte : ' +
          matricule +
          '\n' +
          'Identifiant : ' +
          email +
          '\n' +
          'Mot de passe temporaire : ' +
          motDePasseTemporaire +
          '\n\n' +
          'Veuillez modifier votre mot de passe aprÃƒÂ¨s votre premiÃƒÂ¨re connexion.\n',
      });

      return {
        envoye: true,
        statut:
          'ENVOYE',
      };
    }
    catch {
      return {
        envoye: false,
        statut:
          'ECHEC_ENVOI',
      };
    }
  }

  private async creerEtudiantComplet(
    dto: CreateEtudiantAvecCompteDto,
  ) {
    await this.verifierClasse(
      dto.classeId,
    );

    const normalized =
      await this.verifierDisponibilite(
        dto.matricule,
        dto.email,
      );

    const role =
      await this.prisma.role.findUnique({
        where: {
          code: 'ETUDIANT',
        },
      });

    if (!role) {
      throw new NotFoundException(
        'Le rÃƒÂ´le ETUDIANT est introuvable. Synchronisez le rÃƒÂ©fÃƒÂ©rentiel de sÃƒÂ©curitÃƒÂ©.',
      );
    }

    const motDePasseTemporaire =
      this.genererMotDePasse();

    const hash =
      await bcrypt.hash(
        motDePasseTemporaire,
        12,
      );

    const result =
      await this.prisma.$transaction(
        async (tx) => {
          const etudiant =
            await tx.etudiant.create({
              data: {
                matricule:
                  normalized.matricule,

                nom:
                  dto.nom.trim(),

                prenom:
                  dto.prenom.trim(),

                dateNaissance:
                  this.datePrisma(
                    dto.dateNaissance,
                  ),

                email:
                  normalized.email,

                telephone:
                  dto.telephone
                    ?.trim() ||
                  null,

                actif:
                  true,
              },
            });

          const inscription =
            await tx.inscriptionEtudiant.create({
              data: {
                etudiantId:
                  etudiant.id,

                classeId:
                  dto.classeId,

                anneeAcademique:
                  dto.anneeAcademique,

                statut:
                  (
                    dto.statut ??
                    'ACTIVE'
                  ) as any,
              },
            });

          const utilisateur =
            await tx.utilisateur.create({
              data: {
                email:
                  normalized.email,

                motDePasseHash:
                  hash,

                nomAffichage:
                  (
                    dto.prenom.trim() +
                    ' ' +
                    dto.nom.trim()
                  ).trim(),

                actif:
                  true,

                etudiantId:
                  etudiant.id,

                roles: {
                  create: {
                    roleId:
                      role.id,
                  },
                },
              },

              select: {
                id: true,
                email: true,
                actif: true,
              },
            });

          return {
            etudiant,
            inscription,
            utilisateur,
          };
        },
      );

    const mail =
      await this.envoyerAcces(
        normalized.email,
        (
          dto.prenom.trim() +
          ' ' +
          dto.nom.trim()
        ).trim(),
        normalized.matricule,
        motDePasseTemporaire,
      );

    return {
      ...result,

      acces: {
        identifiant:
          normalized.email,

        emailEnvoye:
          mail.envoye,

        statutEmail:
          mail.statut,
      },
    };
  }

  async creerIndividuellement(
    dto: CreateEtudiantAvecCompteDto,
  ) {
    return this.creerEtudiantComplet(
      dto,
    );
  }

